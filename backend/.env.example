# Server Config
PORT=1002
HOST=0.0.0.0

# Security
SECRET_KEY=change_this_to_a_long_random_secret_in_production

# PostgreSQL Database (Asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/renodesign_db

# Razorpay Live / Test Keys
RAZORPAY_KEY_ID=rzp_live_or_test_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudflare Turnstile Human Verification
CLOUDFLARE_TURNSTILE_SECRET=your_cloudflare_secret_here
CLOUDFLARE_TURNSTILE_SITEKEY=your_cloudflare_sitekey_here

# Master Admin Credentials
ADMIN_USERNAME="your_admin_username_here"
ADMIN_PASSWORD="your_admin_password_here"
